@model LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<section class="auth">
    <div class="auth__form">
        <p class="kicker">Аккаунт</p>
        <h1>Вход</h1>
        <form asp-action="Login" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <label class="field-check">
                <input asp-for="RememberMe" />
                @Html.DisplayNameFor(m => m.RememberMe)
            </label>
            <button class="book book--ink" type="submit">Войти</button>
        </form>
        <p class="auth-switch">Нет аккаунта? <a asp-action="Register">Регистрация</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Бронирование";
}

<section class="page-hero">
    <img src="~/images/dock.jpg" alt="Озеро и пирс у базы" />
    <div class="page-hero__shade" aria-hidden="true"></div>
    <div class="page-hero__copy">
        <p class="kicker kicker--light">Бронирование</p>
        <h1>Выберите Время удобное для вас!</h1>
    </div>
</section>

<section class="page">
    <div class="sheet">
        <div>
            <p class="kicker">Заявка</p>
            <h2>Пока без сохранения.</h2>
            <p>Форма уже на месте. Запись в базу и статусы подключим следующим шагом.</p>
            <form class="form-stack" method="get">
                <div class="field">
                    <label for="booking-date">Дата</label>
                    <input id="booking-date" name="date" type="date" value="@Context.Request.Query["date"]" />
                </div>
                <div class="field">
                    <label for="booking-time">Время</label>
                    <input id="booking-time" name="time" type="time" value="@Context.Request.Query["time"]" />
                </div>
                <div class="field">
                    <label for="guests">Гости</label>
                    <input id="guests" name="guests" type="number" min="1" max="20" value="2" />
                </div>
                <label class="field-check">
                    <input name="sauna" type="checkbox" value="1" /> Баня
                </label>
                <label class="field-check">
                    <input name="gear" type="checkbox" value="1" /> Инвентарь
                </label>
                <label class="field-check">
                    <input name="food" type="checkbox" value="1" /> Питание
                </label>
                <button class="book book--ink" type="submit">Смотреть форму</button>
            </form>
        </div>
        <figure class="sheet__photo">
            <img src="~/images/cabins.jpg" alt="Домики, которые можно забронировать" />
            <figcaption>Домик на площадке</figcaption>
        </figure>
    </div>
</section>
